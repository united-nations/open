+                                    <FinancialPanelBar
+                                      percent={percent}
+                                      color={color}
+                                    />
+                                  </span>
+                                  <span className="w-1/5 max-w-28 min-w-14 shrink-0 text-end font-medium break-words tabular-nums">
+                                    {item.value}
+                                  </span>
+                                </Element>
+                              </li>
+                            );
+                          })}
+                        </ol>
+                      </div>
+                    );
+                  })}
+              </div>
+            </div>
+          );
+        })}
+      </div>
+      {(expandedItemCount > pageSize || limit > pageSize) && (
+        <div className="mt-1 flex flex-wrap gap-x-4">
+          {expandedItemCount > limit && (
+            <button
+              ref={more}
+              type="button"
+              aria-controls={id}
+              className={textAction}
+              onClick={() => {
+                setLimit(limit + pageSize);
+                requestAnimationFrame(() =>
+                  list.current
+                    ?.querySelectorAll<HTMLElement>("[data-ranked-list-item]")
+                    [limit]?.focus(),
+                );
+              }}
+            >
+              Show more ({expandedItemCount - limit} remaining)
+            </button>
+          )}
+          {limit > pageSize && (
+            <button
+              type="button"
+              aria-controls={id}
+              className={textAction}
+              onClick={() => {
+                setLimit(pageSize);
+                requestAnimationFrame(() =>
+                  (
+                    more.current ??
+                    list.current?.querySelector<HTMLElement>("button")
+                  )?.focus(),
+                );
+              }}
+            >
+              Show less
+            </button>
+          )}
+        </div>
+      )}
+    </>
+  );
+}
