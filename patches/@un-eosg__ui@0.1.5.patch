diff --git a/components/ranked-detail-list.tsx b/components/ranked-detail-list.tsx
new file mode 100644
--- /dev/null
+++ b/components/ranked-detail-list.tsx
@@ -0,0 +1,343 @@
+"use client";
+
+import { useId, useRef, useState, type ReactNode } from "react";
+import { ChevronDownIcon } from "lucide-react";
+import { FinancialPanelBar } from "./financial-panel-parts";
+import { cn } from "../lib/utils";
+import { typography } from "../lib/typography";
+
+interface ListGroup {
+  key: string;
+  label: string;
+  color?: string;
+}
+
+export interface RankedDetailItem {
+  id: string;
+  label: string;
+  description?: string;
+  value: ReactNode;
+  amount: number;
+  /** Chart weight for ordering groups whose area uses a different scale. */
+  weight?: number;
+  color?: string;
+  group?: ListGroup;
+  subgroup?: ListGroup;
+  onOpen?: () => void;
+}
+
+function groupItems(
+  items: readonly RankedDetailItem[],
+  dimension: "group" | "subgroup",
+) {
+  const groups = new Map<
+    string,
+    {
+      label?: string;
+      color?: string;
+      weight: number;
+      items: RankedDetailItem[];
+    }
+  >();
+  for (const item of items) {
+    const group = item[dimension];
+    const key = group?.key ?? "";
+    const entry = groups.get(key) ?? {
+      label: group?.label,
+      color: group?.color,
+      weight: 0,
+      items: [],
+    };
+    entry.items.push(item);
+    entry.weight += Math.max(0, item.weight ?? item.amount);
+    groups.set(key, entry);
+  }
+  return [...groups].sort(
+    ([keyA, a], [keyB, b]) => b.weight - a.weight || keyA.localeCompare(keyB),
+  );
+}
+
+const pageSize = 20;
+const textAction =
+  "inline-flex min-h-11 items-center text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-un-blue";
+
+export function RankedDetailList({
+  label,
+  items,
+  empty = (
+    <p className="py-4 text-sm text-muted-foreground">
+      No records match the selected filters.
+    </p>
+  ),
+}: {
+  label: string;
+  items: readonly RankedDetailItem[];
+  empty?: ReactNode;
+}) {
+  const [limit, setLimit] = useState(pageSize);
+  const [collapsed, setCollapsed] = useState<{
+    itemsKey: string;
+    keys: ReadonlySet<string>;
+  }>({ itemsKey: "", keys: new Set() });
