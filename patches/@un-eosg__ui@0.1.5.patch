index 0000000000000000000000000000000000000000..9163ce21aa01ea401b8e0356a5f3bd1f9ca5401e
--- /dev/null
+++ b/components/ranked-detail-list.tsx
@@ -0,0 +1,162 @@
+"use client";
+
+import { useId, useRef, useState, type ReactNode } from "react";
+import { FinancialPanelBar } from "./financial-panel-parts";
+import { cn } from "../lib/utils";
+
+interface ListGroup {
+  key: string;
+  label: string;
+}
+
+export interface RankedDetailItem {
+  id: string;
+  label: string;
+  description?: string;
+  value: ReactNode;
+  amount: number;
+  /** Chart weight for ordering groups whose area uses a different scale. */
+  weight?: number;
+  color?: string;
+  group?: ListGroup;
+  subgroup?: ListGroup;
+  onOpen?: () => void;
+}
+
+function groupItems(
+  items: readonly RankedDetailItem[],
+  dimension: "group" | "subgroup",
+) {
+  const groups = new Map<string, { label?: string; weight: number; items: RankedDetailItem[] }>();
+  for (const item of items) {
+    const group = item[dimension];
+    const key = group?.key ?? "";
+    const entry = groups.get(key) ?? { label: group?.label, weight: 0, items: [] };
+    entry.items.push(item);
+    entry.weight += Math.max(0, item.weight ?? item.amount);
+    groups.set(key, entry);
+  }
+  return [...groups].sort(([keyA, a], [keyB, b]) => b.weight - a.weight || keyA.localeCompare(keyB));
+}
+
+const pageSize = 20;
+const textAction = "inline-flex min-h-11 items-center text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-un-blue";
+
+export function RankedDetailList({
+  label,
+  items,
+  empty = <p className="py-4 text-sm text-muted-foreground">No records match the selected filters.</p>,
+}: {
+  label: string;
+  items: readonly RankedDetailItem[];
+  empty?: ReactNode;
+}) {
+  const [limit, setLimit] = useState(pageSize);
+  const list = useRef<HTMLDivElement>(null);
+  const more = useRef<HTMLButtonElement>(null);
+  const id = useId();
+
+  if (!items.length) return empty;
+
+  const ranked = groupItems(items, "group").map(([key, group]) => ({
+    key,
+    label: group.label,
+    subgroups: groupItems(group.items, "subgroup").map(([key, subgroup]) => ({
+      key,
+      label: subgroup.label,
+      items: [...subgroup.items].sort((a, b) => b.amount - a.amount || a.label.localeCompare(b.label)),
+    })),
+  }));
+  const max = items.reduce((largest, { amount }) => Math.max(largest, amount), 0) || 1;
+  let remaining = limit;
+
+  return (
+    <>
+      <div ref={list} id={id} role="group" aria-label={label} className="space-y-3">
+        {ranked.map((group) => {
+          if (remaining <= 0) return null;
+          return (
+            <div key={group.key} role={group.label ? "group" : undefined} aria-label={group.label}>
+              {group.label && (
+                <p className="border-b px-2 py-2 text-sm font-semibold">{group.label}</p>
+              )}
+              {group.subgroups.map((subgroup) => {
+                if (remaining <= 0) return null;
+                const visible = subgroup.items.slice(0, remaining);
+                remaining -= visible.length;
+                return (
+                  <div key={subgroup.key}>
+                    {subgroup.label && (
+                      <p className="px-2 pt-2 text-xs font-medium text-muted-foreground">{subgroup.label}</p>
+                    )}
+                    <ol role="list" aria-label={subgroup.label ?? group.label ?? label} className="divide-y border-b">
+                      {visible.map((item) => {
+                        const Element = item.onOpen ? "button" : "div";
+                        const percent = (Math.max(0, item.amount) / max) * 100;
+                        const color = item.color ?? "var(--color-un-blue)";
+                        return (
+                          <li key={item.id}>
+                            <Element
+                              data-ranked-list-item=""
+                              type={item.onOpen ? "button" : undefined}
+                              tabIndex={item.onOpen ? undefined : -1}
+                              onClick={item.onOpen}
+                              className={cn(
+                                "flex min-h-11 w-full flex-wrap items-start gap-x-2 gap-y-1.5 px-2 py-2 text-start text-sm focus-visible:outline-2 focus-visible:outline-un-blue sm:flex-nowrap sm:items-center sm:gap-3",
+                                item.onOpen && "cursor-pointer hover:bg-muted",
+                              )}
+                            >
+                              <span className="min-w-0 flex-1 break-words">
+                                <span className="block font-medium">{item.label}</span>
+                                {item.description && <span className="block text-xs text-muted-foreground">{item.description}</span>}
+                              </span>
+                              <span aria-hidden="true" className="order-last w-full shrink-0 sm:order-none sm:w-1/5 sm:max-w-56">
+                                <FinancialPanelBar percent={percent} color={color} />
+                              </span>
+                              <span className="w-1/5 min-w-14 max-w-28 shrink-0 break-words text-end font-medium tabular-nums">{item.value}</span>
+                            </Element>
+                          </li>
+                        );
+                      })}
+                    </ol>
+                  </div>
+                );
+              })}
+            </div>
+          );
+        })}
+      </div>
+      {items.length > pageSize && (
+        <div className="mt-1 flex flex-wrap gap-x-4">
+          {items.length > limit && (
+            <button
+              ref={more}
+              type="button"
+              aria-controls={id}
+              className={textAction}
+              onClick={() => {
+                setLimit(limit + pageSize);
+                requestAnimationFrame(() => list.current?.querySelectorAll<HTMLElement>("[data-ranked-list-item]")[limit]?.focus());
+              }}
+            >
+              Show more ({items.length - limit} remaining)
+            </button>
+          )}
+          {limit > pageSize && (
+            <button
+              type="button"
+              aria-controls={id}
+              className={textAction}
+              onClick={() => {
+                setLimit(pageSize);
+                requestAnimationFrame(() => more.current?.focus());
+              }}
+            >
+              Show less
+            </button>
+          )}
+        </div>
+      )}
+    </>
+  );
+}
