+                                  tabIndex={item.onOpen ? undefined : -1}
+                                  onClick={item.onOpen}
+                                  className={cn(
+                                    "flex min-h-11 w-full flex-wrap items-start gap-x-2 gap-y-1.5 px-3 py-2 text-start text-sm focus-visible:outline-2 focus-visible:outline-un-blue sm:flex-nowrap sm:items-center sm:gap-3",
+                                    item.onOpen &&
+                                      "cursor-pointer hover:bg-muted",
+                                  )}
+                                >
+                                  <span className="min-w-0 flex-1 break-words">
+                                    <span className="block">{item.label}</span>
+                                    {item.description && (
+                                      <span className="block text-xs text-muted-foreground">
+                                        {item.description}
+                                      </span>
+                                    )}
+                                  </span>
